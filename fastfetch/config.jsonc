{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 6,
            "left": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " ➜  "
    },
    "modules": [
        {
            "type": "custom",
            "format": " \u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  \u001b[38m  \u001b[39m       \u001b[38m  \u001b[37m  \u001b[36m  \u001b[35m  \u001b[34m  \u001b[33m  \u001b[32m  \u001b[31m  \u001b[90m"
        },
        "break",

        // {
        //     "type": "title",
        //     "key": "User ",
        //     "format": "{user-name}@{host-name}"
        // },
        // "break",

        {
            "type": "host",
            "key": "PC   ",
            "keyColor": "blue",
            "format": "{name} [{family}]"
        },
        {
            "type": "display",
            "key": " ├  ",
            "keyColor": "blue"
        },
        {
            "type": "cpu",
            "key": " ├  ",
            "keyColor": "blue",
            "format": "{name} ({cores-physical}) @ {freq-max}"
        },
        {
            "type": "gpu",
            "key": " ├  ",
            "keyColor": "blue",
            "format": "{name} ({core-count}) @ {frequency} [{type}]"
        },
        {
            "type": "memory",
            "key": " ├  ",
            "keyColor": "blue"
        },
        {
            "type": "disk",
            "key": " ├ 󰋊 ",
            "keyColor": "blue",
            "folders": "/",
            "format": "{size-used} / {size-total} ({size-percentage}) [{filesystem}]"
        },
        {
            "type": "swap",
            "key": " └ 󰓡 ",
            "keyColor": "blue"
        },
        "break",

        {
            "type": "os",
            "key": "OS   ",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": " ├  ",
            "keyColor": "magenta"
        },
        {
            "type": "uptime",
            "key": " ├ 󱎫 ",
            "keyColor": "magenta"
        },
        {
            "type": "packages",
            "key": " ├ 󰏖 ",
            "keyColor": "magenta"
        },
        {
            "type": "shell",
            "key": " └  ",
            "keyColor": "magenta"
        },
        "break",

        {
            "type": "wm",   // window manager
            "key": "WM   ",
            "keyColor": "red"
        },
        {
            "type": "wmtheme",
            "key": " ├ 󰔎 ",
            "keyColor": "red"
        },
        {
            "type": "de",   // desktop environment
            "key": " ├ 󰧨 ",
            "keyColor": "red"
        },
        {
            "type": "font",
            "key": " ├  ",
            "keyColor": "red"
        },
        {
            "type": "cursor",
            "key": " ├ 󰳽 ",
            "keyColor": "red"
        },
        {
            "type": "terminal",
            "key": " ├  ",
            "keyColor": "red"
        },
        {
            "type": "terminalfont",
            "key": " ├ 󰛖 ",
            "keyColor": "red"
        },
        {
            "type": "editor",
            "key": " ├  ",
            "keyColor": "red"
        },
        {
            "type": "locale",
            "key": " └  ",
            "keyColor": "red"
        },
        "break",

        "colors",
        "break",

        {
            "type": "custom",
            "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  \u001b[38m  \u001b[39m       \u001b[38m  \u001b[37m  \u001b[36m  \u001b[35m  \u001b[34m  \u001b[33m  \u001b[32m  \u001b[31m  \u001b[90m"
        }
    ]
}
