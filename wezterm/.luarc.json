{
    "runtime.version": "Lua 5.4",
    "diagnostics.severity": {
    },
    "format.defaultConfig": {
        "indent_style": "space",
        "indent_size": "4",
        "quote_style": "single",
        "call_arg_parentheses": "keep",
        "max_line_length": 120,
        "end_of_line": "lf",
        "insert_final_newline": "true"
    },
    "workspace.library": [
    ],
    "workspace.checkThirdParty": false,
    "hint.enable": true
}
