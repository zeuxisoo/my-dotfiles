{
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },

    "buffer_font_size": 15,
    "buffer_font_family": "FantasqueSansM Nerd Font Mono",
    "buffer_font_weight": 450,
    "buffer_font_features": {
        "calt": true,
        "ss01": true,
        "ss02": true,
        "ss03": true,
        "ss04": true,
        "ss05": true,
        "ss06": true,
        "ss19": true,
        "ss20": true,
        "zero": true,
        "onum": true
    },

    "icon_theme": "Catppuccin Macchiato",
    "theme": "Catppuccin Mocha - No Italics",
    "theme_overrides": {
        "Catppuccin Mocha - No Italics": {
            "element.background": "#84c4df33",
            "element.hover": "#84c4df29",
            "element.selected": "#84c4df39",
            "panel.indent_guide": "#ccd0da99",
            "panel.indent_guide_active": "#acb0be",
            "panel.indent_guide_hover": "#8839ef",
            "tab.active_background": "#282a36ff",
            "tab.inactive_background": "#1c1d26ff",
            "text": "#f8f8f2ff"
        }
    },

    "scroll_beyond_last_line": "off",
    "ensure_final_newline_on_save": true,
    "format_on_save": "off",
    "restore_on_startup": "last_session",
    "tab_size": 4,
    "hard_tabs": false,
    "remove_trailing_whitespace_on_save": true,
    "show_whitespaces": "all",
    "indent_guides": {
        "enabled": true,
        "line_width": 1,
        "coloring": "indent_aware",
        "background_coloring": "disabled"
    },
    "minimap": {
        "show": "never",
        "current_line_highlight": "line"
    },
    "completions": {
        "words": "fallback"
    },

    "git_panel": {
        "tree_view": true
    },

    "languages": {
        "PHP": {
            "format_on_save": "on",
            "completions": {
                "words_min_length": 3
            },
        },
        "Make": {
            "tab_size": 4,
            "hard_tabs": true
        },
        "Go": {
            "tab_size": 4,
            "hard_tabs": true
        },
        "V": {
            "tab_size": 4,
            "hard_tabs": true
        },
        "CSS": {
            "language_servers": ["tailwindcss-language-server", "microsoft/vscode-html-languageservice"]
        },
        "Vue.js": {
            "linked_edits": false,
            "format_on_save": "on"
        },
        "TypeScript": {
            "format_on_save": "on"
        },
        "HTML": {
            "use_autoclose": false
        }
    },

    "agent": {
        "default_profile": "write",
        "default_model": {
            "provider": "Nvidia",
            "model": "minimaxai/minimax-m2.1"
        },
        "model_parameters": []
    },

    "experimental.theme_overrides": {
        "editor.indent_guide_active": "#FF0000",
        "editor.indent_guide": "#FFFFFF"
    }
}
