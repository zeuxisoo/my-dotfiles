{
    "icon_theme": "Catppuccin Macchiato",
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },

    "buffer_font_size": 15,
    "buffer_font_family": "FantasqueSansM Nerd Font Mono",
    "buffer_font_weight": 450,
    "buffer_font_features": {
        "calt": true,
        "ss01": true,
        "ss02": true,
        "ss03": true,
        "ss04": true,
        "ss05": true,
        "ss06": true,
        "ss19": true,
        "ss20": true,
        "zero": true,
        "onum": true
    },

    "theme": "Catppuccin Macchiato - No Italics",

    "scroll_beyond_last_line": "off",
    "ensure_final_newline_on_save": true,
    "format_on_save": "off",
    "restore_on_startup": "last_session",
    "tab_size": 4,
    "hard_tabs": false,
    "remove_trailing_whitespace_on_save": true,
    "show_whitespaces": "all",
    "indent_guides": {
        "enabled": true,
        "line_width": 1,
        "coloring": "indent_aware",
        "background_coloring": "disabled"
    },
    "minimap": {
        "show": "never",
        "current_line_highlight": "line"
    },
    "completions": {
        "words": "fallback"
    },

    "languages": {
        "PHP": {
            "format_on_save": "on",
            "completions": {
                "words_min_length": 3
            },
            "formatter": {
                "external": {
                    "command": "bash",
                    "arguments": [
                        "-c",
                        "cat > {buffer_path} && php ./vendor/bin/pint --config ./pint.json --quiet {buffer_path} && cat {buffer_path}"
                    ]
                }
            }
        },
        "Make": {
            "tab_size": 4,
            "hard_tabs": true
        },
        "Go": {
            "tab_size": 4,
            "hard_tabs": true
        },
        "V": {
            "tab_size": 4,
            "hard_tabs": true
        },
        "CSS": {
            "language_servers": ["tailwindcss-language-server", "microsoft/vscode-html-languageservice"]
        },
        "Vue.js": {
            "linked_edits": false
        },
        "HTML": {
            "use_autoclose": false
        }
    },

    "agent": {
        "default_profile": "write",
        "default_model": {
            "provider": "google",
            "model": "gemini-2.5-flash-lite"
        },
        "model_parameters": []
    },

    "experimental.theme_overrides": {
        "editor.indent_guide_active": "#FF0000",
        "editor.indent_guide": "#FFFFFF"
    }
}
